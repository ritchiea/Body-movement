let bodyPose; 
let video; 
let poses = []; 
let connections;
let balls = [];
let score = 0;
let targetBall = 0;

// Ball class
class Ball {
  constructor() {
    this.x = random(20, width - 20);
    this.y = -20;
    this.size = 30;
    this.speed = random(2, 5);
    this.color = color(255, 0, 0);
    this.touched = false;
  }
  
  update() {
    this.y += this.speed;
    
    // Check if any keypoint touches this ball
    if (!this.touched && poses.length > 0) {
      for (let pose of poses) {
        for (let keypoint of pose.keypoints) {
          if (keypoint.confidence > 0.1) {
            let d = dist(keypoint.x, keypoint.y, this.x, this.y);
            if (d < this.size / 2 && Object.is(this, balls[targetBall])) {
              this.touched = true;
              this.color = color(0, 0, 255);
              score++;
              targetBall++;
              break;
            }
          }
        }
        if (this.touched) break;
      }
    }
    
    // Return true if ball is off screen
    return this.y > height + this.size;
  }
  
  display() {
    fill(this.color);
    noStroke();
    circle(this.x, this.y, this.size);
  }
}

function preload() {
  // Load the bodyPose model
  bodyPose = ml5.bodyPose();
}

function setup() {
  // Get the skeleton connection information
  connections = bodyPose.getSkeleton();
  createCanvas(640, 480);
  
  // Create the video and hide it
  video = createCapture(VIDEO);
  video.size(640, 480);
  video.hide();
  
  bodyPose.detectStart(video, gotPoses);
  
  // Create new balls at regular intervals
  setInterval(addBall, 1000);
}

function addBall() {
  balls.push(new Ball());
}

// Callback function for when the model returns pose data
function gotPoses(results) {
  // Store the model's results in a global variable
  poses = results;
}

function draw() {
  // Display the video
  image(video, 0, 0, width, height);
  
  // Update and display balls
  for (let i = balls.length - 1; i >= 0; i--) {
    balls[i].display();
    if (balls[i].update()) {
      balls.splice(i, 1); // Remove balls that are off screen
    }
  }
  
  // Draw the skeleton connections
  for (let i = 0; i < poses.length; i++) {
    let pose = poses[i];
    
    for (let j = 0; j < connections.length; j++) {
      let pointAIndex = connections[j][0];
      let pointBIndex = connections[j][1];
      let pointA = pose.keypoints[pointAIndex];
      let pointB = pose.keypoints[pointBIndex];
      
      // Only draw a line if we have confidence in both points
      if (pointA.confidence > 0.1 && pointB.confidence > 0.1) {
        stroke(255, 0, 0);
        strokeWeight(2);
        line(pointA.x, pointA.y, pointB.x, pointB.y);
      }
    }
  }
  
  // Iterate through all the poses
  for (let i = 0; i < poses.length; i++) {
    let pose = poses[i];
    
    // Iterate through all the keypoints for each pose
    for (let j = 0; j < pose.keypoints.length; j++) {
      let keypoint = pose.keypoints[j];
      
      // Only draw a circle if the keypoint's confidence is greater than 0.1
      if (keypoint.confidence > 0.1) {
        fill(0, 255, 0);
        noStroke();
        circle(keypoint.x, keypoint.y, 10);
      }
    }
  }
  
  // Display score
  fill(255);
  textSize(32);
  textAlign(LEFT, TOP);
  text("Score: " + score, 10, 10);
}
